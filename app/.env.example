# Contract addresses. Leave ANY unset to run the app in mock mode (demo data).
NEXT_PUBLIC_FACTORY=
NEXT_PUBLIC_POINTS=
NEXT_PUBLIC_SPINVRF=
NEXT_PUBLIC_JACKPOT=
NEXT_PUBLIC_USDG=
NEXT_PUBLIC_ROUTER=

# mainnet (chain id 4663, default) or testnet (46630)
NEXT_PUBLIC_CHAIN=mainnet

# Geofence: comma-separated ISO 3166-1 alpha-2 codes.
BLOCKED_COUNTRIES=US,GB,CA,CH,AE,SG
